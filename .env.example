# Synthetic local credentials only. All ports are fixed to 127.0.0.1:39850-39859.
COMPOSE_PROJECT_NAME=masonwing-dev
MASONWING_ENV=LOCAL
POSTGRES_ADMIN_PASSWORD=masonwing-local-admin
KEYCLOAK_ADMIN_PASSWORD=masonwing-local-admin
MINIO_ROOT_USER=masonwing-local
MINIO_ROOT_PASSWORD=masonwing-local-storage
BAO_DEV_ROOT_TOKEN_ID=masonwing-local-root
# The application scaffold rejects external mutation and nonzero live budgets.
MASONWING_EXTERNAL_MUTATIONS=false
MASONWING_LIVE_BUDGET_MICROUNITS=0
